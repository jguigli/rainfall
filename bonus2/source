// 0: en fl: 1, nl: 2

int language = 0;

void greetuser(char *name)
{
	char out[19];

	if (language == 1) {
		strcpy(out, "Hyvää päivää ");
	}
	else if (language == 2) {
		strcpy(out, "Goedemiddag! ");
	}
	else if (language == 0) {
		strcpy(out, "Hello ");
	}
	strcat(out, name);
	puts(out);
	return;
}

int main(int ac, char *av[])
{
	char buf0[40];
	char buf1[32];
	char *lang;

	if (ac != 3) {
		return 1;
	}

	memset(buf0, 0, 76);
	strncpy(buf0, av[1], 40);
	strncpy(buf1, av[2], 32);
	lang = getenv("LANG");
	if (lang) {
		if (memcmp(lang, "fl", 2) == 0) {
			language = 1;
		}
		else if (memcmp(lang, "nl", 2) == 0) {
			language = 2;
		}
	}
	greetuser(buf1);

	return 0;
}
